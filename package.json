{
  "name": "gully-umpire",
  "version": "0.1.0",
  "private": true,
  "description": "Shout the ball, keep the phone in your pocket: an open-weight AI scorer and commentator for gully cricket",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:api": "node --test --test-concurrency=1 test/api.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.js",
    "test:all": "npm run lint && npm test && npm run build && npm run test:api && npm run test:e2e"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "puppeteer-core": "^25.12.0"
  },
  "license": "MIT"
}
