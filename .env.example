# Free key from https://console.groq.com/keys
# Without it the buttons and simple typed calls still work; voice, commentary and reports need it.
GROQ_API_KEY=

# Models (all open-weight, served by Groq by default)
# WHISPER_MODEL=whisper-large-v3-turbo
# PARSE_MODEL=openai/gpt-oss-20b
# RULES_MODEL=openai/gpt-oss-20b
# COMMENTARY_MODEL=qwen/qwen3.8-27b
# COMMENTARY_BACKUP_MODEL=openai/gpt-oss-20b
# REPORT_MODEL=openai/gpt-oss-120b

# Run against any other OpenAI-compatible server instead. Voice needs one that also serves
# /audio/transcriptions (a local faster-whisper server does; Ollama alone doesn't).
# LLM_BASE_URL=http://localhost:8000/v1

# Keep matches across restarts (free MongoDB Atlas M0 cluster). Without it matches go to a JSON file.
# MONGODB_URI=
# DATA_DIR=./data

PORT=4100
